<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 cannot tell cloud backup from device transfer, so neither
     carries anything; move worlds with Settings, Download backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
