  "blocks": [
    { "id": "b1", "kind": "text", "text": "The burial galleries of drowned Maro, sealed since [[The Drowning War]]. The entrance below the Lantern Shrine in [[Port Vellen]] is bricked up and warded — officially, no one has been inside for forty years.", "secret": false },
    { "id": "b2", "kind": "text", "text": "Officially. The outer galleries are a smuggler den reachable by the tunnel behind the fish market. The inner seal still holds — it can only be opened by [[The Hollow Crown]], which is why [[The Veiled Hand]] is tearing the Reach apart looking for it.", "secret": true },
    { "id": "b3", "kind": "text", "text": "Room 1 is the entrance gallery. The pit trap before the double doors resets itself — that's not clockwork, that's the crypt *wanting* it armed.", "secret": true },
